# Neon pooled PostgreSQL connection string. Empty disables run persistence.
DATABASE_URL=

# Clerk session verification. Keep the secret key server-side.

# Browser origins allowed to call the API.
RISK_ATLAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://risk-atlas-self.vercel.app

# Optional model-backed exposure extraction.
OPENAI_API_KEY=
RISK_ATLAS_OPENAI_MODEL=gpt-4o-mini

# Optional replacement CSV. Empty uses the bundled sample.
RISK_ATLAS_EXPOSURE_CSV=