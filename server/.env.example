# Neon pooled PostgreSQL connection string. Empty disables run persistence.
DATABASE_URL=

# Clerk Frontend API origin, such as https://your-instance.clerk.accounts.dev.
# The API verifies Bearer session tokens against this issuer's JWKS.
CLERK_ISSUER=
# Optional PEM public key for verification without a JWKS request.
CLERK_JWT_KEY=

# Browser origins allowed to call the API.
RISK_ATLAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://risk-atlas-self.vercel.app

# AI provider for exposure extraction, audio transcription, and underwriter chat.
RISK_ATLAS_AI_PROVIDER=openai
OPENAI_API_KEY=
RISK_ATLAS_OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
RISK_ATLAS_GEMINI_MODEL=gemini-2.5-flash

# Optional replacement CSV. Empty uses the bundled sample.
RISK_ATLAS_EXPOSURE_CSV=
