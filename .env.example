# RISK_ATLAS_EXPOSURE_CSV=/absolute/path/to/exposure.csv

# Copy the pooled connection string from Neon > Connect > Connection string.
# Keep this value in .env on the backend only; never add it to VITE_* variables.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Clerk API verification. Keep the secret key on the backend only.
# CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
# Comma-separated frontend origins allowed in Clerk session tokens.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
